[Unit]
Description=Tor Location Manager Web Panel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=torpanel
Group=torpanel
WorkingDirectory=/opt/tor-location-manager
Environment=TORPANEL_ENV_FILE=/etc/tor-location-manager/panel.env
EnvironmentFile=/etc/tor-location-manager/panel.env
ExecStart=/opt/tor-location-manager/venv/bin/gunicorn --workers 2 --threads 4 --timeout 120 --bind ${TORPANEL_BIND}:${TORPANEL_PORT} wsgi:app
Restart=on-failure
RestartSec=3
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/tor-location-manager /etc/tor-location-manager

[Install]
WantedBy=multi-user.target
